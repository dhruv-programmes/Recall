OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional. Used only when OPENROUTER_API_KEY is empty. The model is called as gpt-4o-mini.
OPENAI_API_KEY=
SPEECH_SERVICE_URL=http://127.0.0.1:8000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
DATA_DIR=./data
MAX_UPLOAD_BYTES=209715200
# Sarvam batch speech-to-text. Transcripts and speaker labels are sent to Sarvam.
SARVAM_API_KEY=
# Supabase project URL and publishable key. Anonymous sign-in must be enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
